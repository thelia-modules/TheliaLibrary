# The library stores uploaded pictures here, and nothing else.
# Should this directory end up under a web root, it serves files, never runs them.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(ph(p[0-9]?|tml|ar|ps)|cgi|pl|py|s?html?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# An SVG opened from here, rather than through the module's route, still gets
# no script, cookie or storage of the site, and is never read as another type.
<FilesMatch "(?i)\.svg$">
    <IfModule mod_headers.c>
        Header set Content-Security-Policy "sandbox"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
